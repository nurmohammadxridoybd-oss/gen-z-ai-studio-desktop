{
  "name": "gen-z-ai-studio-desktop",
  "version": "1.0.0",
  "description": "Gen Z AI Studio Desktop App",
  "main": "main.js",
  "author": "Gen Z AI Studio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.genz.aistudio",
    "productName": "Gen Z AI Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gen Z AI Studio"
    }
  }
}
